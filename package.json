{
  "name": "build-your-agent",
  "version": "0.1.1",
  "private": true,
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "pnpm run generate:build-your-agent && next dev",
    "dev:clean": "rm -rf .next && pnpm run generate:build-your-agent && next dev",
    "generate:build-your-agent": "node scripts/generate-build-your-agent-content.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "prod:watch": "node scripts/prod-watch.mjs",
    "build": "pnpm run generate:build-your-agent && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run code-agent-course/ && node --test lib/*.test.ts scripts/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@monaco-editor/react": "^4.7.0",
    "@next/mdx": "15.1.7",
    "@webcontainer/api": "^1.6.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "codehike": "^1.0.4",
    "lucide-react": "^0.511.0",
    "mermaid": "^12.3.0",
    "monaco-editor": "^0.55.1",
    "next": "15.1.9",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.10",
    "@types/mdx": "2.0.13",
    "@types/node": "^20",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "autoprefixer": "^10.0.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.1.7",
    "postcss": "^8",
    "tailwindcss": "^3.4.3",
    "typescript": "5.5.4",
    "vitest": "^4.1.9"
  }
}
