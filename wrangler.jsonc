{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "build-your-agent",
  "compatibility_date": "2025-10-01",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "blog.deepdrink.ai",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  }
}
